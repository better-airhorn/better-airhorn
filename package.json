{
	"$schema": "https://json.schemastore.org/package",
	"name": "better-airhorn",
	"description": "A Discord soundboard bot: upload your own sounds, play them in voice, discover and like other people's sounds",
	"version": "5.0.0",
	"private": true,
	"license": "SEE LICENSE IN ./LICENSE.md",
	"repository": "github:better-airhorn/better-airhorn",
	"contributors": [
		"Clemens E (https://github.com/Clemens-E)",
		"Quentin W (https://github.com/qwright10)"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@types/bun": "^1.3.5",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2"
	}
}
