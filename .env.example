# Copy to .env (dev) or ./env/better-airhorn.env (prod) and fill in.
# docker compose reads these for ${VAR} interpolation; the apps read them from their environment.

## Discord application (Developer Portal > General Information / Bot)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

## Internal
# shared secret between slashbackend and voicenode; any long random string (openssl rand -hex 32)
VOICENODE_ACCESS_KEY=
# password of the postgres superuser; the apps connect as postgres@postgres:5432/postgres
POSTGRES_PASSWORD=
# full connection string, takes precedence over POSTGRES_PASSWORD (e.g. postgresql://postgres:pw@localhost:5432/postgres)
# DATABASE_URL=
# slashbackend -> voicenode base URL (default http://voicenode:8888)
# VOICENODE_URL=
# directory voicenode stores <id>.ogg files in (default /data/sounds)
# SOUNDS_DIR=
# HTTP port; defaults: slashbackend 8080, voicenode 8888
# PORT=
# debug | info | warn | error (default info)
LOG_LEVEL=info

## Access
# comma-separated user ids allowed to use admin commands; leave it commented out for the built-in owner ids
# (an empty value means nobody is admin)
# ADMIN_IDS=
# comma-separated guild ids; when set, commands sync to these guilds only (instant, for development)
DEV_GUILD_IDS=

## top.gg
# signing secret (starts with whs_) shown after saving the vote webhook URL in the top.gg dashboard;
# slashbackend checks the x-topgg-signature header of POST /votes/topgg with it
TOPGG_WEBHOOK_SECRET=
# legacy webhooks only: the "Authorization" value set in the bot edit form on top.gg
BOTLISTS_DBL_SECRET=
# top.gg API token (bot page -> Edit -> Webhooks -> Token); voicenode posts the server count every 30 minutes.
# Leave empty in development so a test bot never overwrites the listing's count.
BOTLISTS_TOPGG=

## Production host paths (docker-compose.yml only)
# bind-mount root holding pgsql17, sounds, stats
DATA_ROOT=/srv/better-airhorn
# backup root holding the postgres dumps (and the sounds mirror, see DEPLOYMENT.md)
BACKUP_ROOT=/mnt/backup/better-airhorn

## MinIO export (scripts/migrate-minio.ts only, needed once for the v4 -> v5 upgrade)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKETNAME=
